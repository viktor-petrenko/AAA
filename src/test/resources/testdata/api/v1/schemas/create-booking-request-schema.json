{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "firstname",
    "lastname",
    "totalprice",
    "depositpaid",
    "bookingdates",
    "additionalneeds"
  ],
  "additionalProperties": false,
  "properties": {
    "firstname": {
      "type": "string",
      "minLength": 1
    },
    "lastname": {
      "type": "string",
      "minLength": 1
    },
    "totalprice": {
      "type": "integer",
      "minimum": 1
    },
    "depositpaid": {
      "type": "boolean"
    },
    "bookingdates": {
      "type": "object",
      "required": [
        "checkin",
        "checkout"
      ],
      "additionalProperties": false,
      "properties": {
        "checkin": {
          "type": "string"
        },
        "checkout": {
          "type": "string"
        }
      }
    },
    "additionalneeds": {
      "type": "string"
    }
  }
}